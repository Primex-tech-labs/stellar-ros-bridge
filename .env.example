# Copy to `.env` and fill in locally. NEVER commit `.env` or real keys.

# --- Stellar ---
# Secret key (S...) for the robot/operator account. Use TESTNET ONLY in dev.
STELLAR_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Public key (G...) corresponding to STELLAR_SECRET (safe to share).
STELLAR_PUBLIC=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# RPC endpoint. Default targets Stellar testnet.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK=testnet
# Deployed TaskEscrow contract id, once available.
TASK_ESCROW_CONTRACT_ID=

# --- ROS 2 ---
ROS_DOMAIN_ID=0
RUST_LOG=info
